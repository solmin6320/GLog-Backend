# 팀 (기능명세서 2장): 생성·참가·아이디 초대·추방·탈퇴·위임·삭제·공개 설정. ACTIVE 회원만 호출할 수 있고,
# 팀장 전용·팀원 전용은 팀을 읽어서 검사한다(비소속·비팀장 FORBIDDEN, 없는/삭제된 팀 NOT_FOUND). 관리자도 예외 없다

extend type Query {
    "내 팀 목록 (TM-01). 참가한 순서(오래된 순). 건수 제한이 없어 페이지 없이 전부 준다. 비공개 팀도 본인에게는 실제 이름"
    myTeams: [Team!]!
    "팀 기본 정보. 그 팀의 팀원·팀장만 볼 수 있다"
    team(id: ID!): Team!
    "팀원 목록 (TM-06). 그 팀의 팀원·팀장만. 팀장이 맨 앞, 나머지는 참가한 순서"
    teamMembers(teamId: ID!): [TeamMember!]!
    "초대코드 다시 확인 (TM-06). 그 팀의 팀장만. 코드는 생성할 때 한 번 정해지고 재발급은 없다"
    teamInviteCode(teamId: ID!): String!
    "받은 초대 목록 (TM-04). 최신순. 비공개 팀이어도 초대받은 당사자에게는 실제 팀 이름"
    receivedTeamInvitations: [ReceivedTeamInvitation!]!
    "보낸 초대 중 대기 중인 목록 (TM-06). 그 팀의 팀장만. 최신순"
    sentTeamInvitations(teamId: ID!): [SentTeamInvitation!]!
}

extend type Mutation {
    "팀을 만든다. 만든 사람이 팀장이고, 초대코드가 이때 한 번 발급된다 (TM-02)"
    createTeam(input: CreateTeamInput!): CreateTeamPayload!
    "팀 이름·소개·공개 설정을 고친다 (팀장만). 보낸 항목만 바뀌고, 소개는 빈 문자열이면 비워진다"
    updateTeam(teamId: ID!, input: UpdateTeamInput!): Team!
    """
    초대코드로 참가한다 (TM-03). 대소문자 구분 없음.
    없는 코드 TEAM_CODE_NOT_FOUND, 이미 참가 TEAM_ALREADY_JOINED, 추방 후 1년 차단 TEAM_JOIN_BLOCKED(남은 기간은 알려주지 않는다)
    """
    joinTeamByCode(code: String!): Team!
    """
    GitHub 아이디로 초대한다 (팀장만, TM-06). 가입한(승인된) 회원만 찾는다.
    없는 아이디 INVITEE_NOT_FOUND, 이미 팀원 INVITEE_ALREADY_MEMBER, 대기 중인 초대가 이미 있으면 INVITATION_DUPLICATE.
    추방한 사람도 초대할 수 있다 (초대코드 차단과 무관)
    """
    inviteToTeam(teamId: ID!, githubLogin: String!): SentTeamInvitation!
    "보낸 초대를 철회한다 (팀장만). 대기 중인 초대만"
    cancelTeamInvitation(invitationId: ID!): Boolean!
    """
    받은 초대를 수락해 바로 참가한다 (TM-04).
    이미 다른 경로로 참가했으면 INVITATION_ALREADY_JOINED, 팀이 없어졌으면 TEAM_GONE (둘 다 초대는 정리된다).
    추방됐던 팀으로 돌아오면 그 팀 경고 카테고리가 복원된다
    """
    acceptTeamInvitation(invitationId: ID!): Team!
    "받은 초대를 거절한다"
    declineTeamInvitation(invitationId: ID!): Boolean!
    "팀원을 추방한다 (팀장만). 그 팀 경고 카테고리가 빠지고, 이 팀 초대코드로는 1년간 재참가할 수 없다. 팀장 본인은 추방할 수 없다"
    kickTeamMember(teamId: ID!, memberId: ID!): Boolean!
    """
    팀에서 나간다 (자진 탈퇴, 경고는 유지). 팀장은 나갈 수 없다:
    넘길 팀원이 있으면 LEADER_MUST_TRANSFER, 혼자면 LEADER_LAST_MEMBER(팀 삭제만 가능)
    """
    leaveTeam(teamId: ID!): Boolean!
    "팀장을 다른 팀원에게 넘긴다 (팀장만). 되돌릴 수 없다"
    transferTeamLeadership(teamId: ID!, newLeaderId: ID!): Team!
    "팀을 삭제한다 (팀장만). 글은 남고 팀 연결만 끊기며, 팀 경고 카테고리가 빠진다"
    deleteTeam(teamId: ID!): Boolean!
}

extend type Post {
    "연결된 팀 이름. 비공개 팀·삭제된 팀·연결 없는 글은 null (열람자와 무관, E-23)"
    teamName: String
}

type Team {
    id: ID!
    name: String!
    description: String
    isPublic: Boolean!
    leader: TeamPerson!
    "내가 이 팀의 팀장인가"
    isLeader: Boolean!
    memberCount: Int!
    "내가 이 팀에 참가한 시각 (KST, ISO-8601)"
    joinedAt: String!
    createdAt: String!
}

"이름만 보여주는 회원 정보"
type TeamPerson {
    id: ID!
    nickname: String!
    githubLogin: String!
    profileImageUrl: String
}

type TeamMember {
    id: ID!
    nickname: String!
    githubLogin: String!
    profileImageUrl: String
    isLeader: Boolean!
    "이 팀에 참가한 시각 (KST, ISO-8601)"
    joinedAt: String!
}

type ReceivedTeamInvitation {
    id: ID!
    teamId: ID!
    teamName: String!
    "초대한 팀장"
    inviter: TeamPerson!
    createdAt: String!
}

type SentTeamInvitation {
    id: ID!
    invitee: TeamPerson!
    createdAt: String!
}

"팀 생성 결과. 초대코드는 이때 한 번 보여준다. 이후에는 팀장이 teamInviteCode로 다시 확인한다"
type CreateTeamPayload {
    team: Team!
    inviteCode: String!
}

input CreateTeamInput {
    "1~20자"
    name: String!
    "100자 이내 (선택)"
    description: String
    "생략하면 공개"
    isPublic: Boolean
}

input UpdateTeamInput {
    name: String
    description: String
    isPublic: Boolean
}
