# 면제 (기능명세서 7장, 관리자 9장 면제 관리). 면제 기간 관리와 개인 면제 승인·거절은 관리자,
# 개인 면제 요청은 그 팀의 팀장. 소급 면제는 재계산 미리보기(무변경)를 먼저 부른 뒤 확인하고 반영한다

extend type Query {
    "내가 보낸 개인 면제 요청 목록 (TM-08 ⑤). 최신순 커서 기반 20개"
    myPersonalExemptionRequests(
        "이전 페이지의 nextCursor"
        after: String
    ): PersonalExemptionPage!
    "면제 기간 목록 (관리자). 주차 최신순 커서 기반 20개"
    exemptionPeriods(
        "이전 페이지의 nextCursor"
        after: String
    ): ExemptionPeriodPage!
    """
    그 주를 면제 기간으로 등록하면 바뀌는 판정과 영향 미리보기 (관리자, E-45). 계산만 하고 아무것도 바꾸지 않는다.
    아직 판정되지 않은 주는 retroactive=false이고 items가 비어 있다. 월요일이 아니면 INVALID_INPUT
    """
    previewExemptionPeriod(weekStart: String!): RetroExemptionPreview!
    "개인 면제 요청 목록 (관리자). 기본은 대기 건. 상태별 최신순 커서 기반 20개"
    personalExemptionRequests(
        status: PersonalExemptionStatus = PENDING
        "이전 페이지의 nextCursor"
        after: String
    ): PersonalExemptionPage!
    """
    개인 면제를 승인하면 바뀌는 판정과 영향 미리보기 (관리자, E-45). 계산만 하고 아무것도 바꾸지 않는다.
    이미 처리된 요청은 ALREADY_HANDLED
    """
    previewPersonalExemptionApproval(id: ID!): RetroExemptionPreview!
}

extend type Mutation {
    """
    개인 면제를 요청한다 (그 팀의 팀장만, TM-08). memberId는 그 팀의 팀원이거나 팀장 본인.
    같은 회원·주간에 대기·승인 건이 있으면 EXEMPTION_REQUEST_DUPLICATE, 팀장이 아니면 FORBIDDEN.
    사유는 1~200자, weekStart는 월요일 yyyy-MM-dd
    """
    requestPersonalExemption(teamId: ID!, memberId: ID!, weekStart: String!, reason: String!): PersonalExemption!
    """
    면제 기간을 등록한다 (관리자). 이미 판정된 주면 그 주 통과·미달 판정이 면제로 바뀌고 경고가 다시 계산된다.
    같은 주가 있으면 EXEMPTION_PERIOD_DUPLICATE
    """
    createExemptionPeriod(input: ExemptionPeriodInput!): ExemptionPeriod!
    """
    면제 기간의 주차·사유를 고친다 (관리자). 다른 주로 옮기면 새 주에 소급 면제가 걸린다.
    이미 면제로 바뀐 판정은 되돌리지 않는다(확정 판정은 정정으로만 바뀐다)
    """
    updateExemptionPeriod(id: ID!, input: ExemptionPeriodInput!): ExemptionPeriod!
    "면제 기간을 지운다 (관리자). 이미 면제로 바뀐 판정은 되돌리지 않는다"
    deleteExemptionPeriod(id: ID!): Boolean!
    "개인 면제 요청을 승인한다 (관리자). 이미 판정된 주면 그 회원의 통과·미달이 면제로 바뀐다. 이미 처리된 요청은 ALREADY_HANDLED"
    approvePersonalExemption(id: ID!): PersonalExemption!
    "개인 면제 요청을 거절한다 (관리자). 사유 필수(1~500자, E-48)"
    rejectPersonalExemption(id: ID!, reason: String!): PersonalExemption!
}

enum PersonalExemptionStatus {
    PENDING
    APPROVED
    REJECTED
}

input ExemptionPeriodInput {
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "1~200자"
    reason: String!
}

type ExemptionPeriod {
    id: ID!
    "그 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "그 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    reason: String!
    createdAt: String!
    updatedAt: String
}

type ExemptionPeriodPage {
    items: [ExemptionPeriod!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"개인 면제 요청 한 건. 팀 이름은 싣지 않는다"
type PersonalExemption {
    id: ID!
    "면제 대상"
    member: AdminMemberBrief!
    "요청한 팀장"
    requester: AdminMemberBrief!
    weekStart: String!
    weekEnd: String!
    status: PersonalExemptionStatus!
    reason: String!
    "거절됐을 때만 값이 있다"
    rejectReason: String
    respondedAt: String
    createdAt: String!
    "그 주가 이미 전체 면제 기간이다 (E-44). 두 면제는 독립으로 보존되고 따로 승인하지 않아도 판정에서 빠진다"
    overlapsExemptionPeriod: Boolean!
}

type PersonalExemptionPage {
    items: [PersonalExemption!]!
    "다음 페이지 커서. null이면 마지막"
    nextCursor: String
}

"소급 면제 미리보기. retroactive=false면 아직 판정 전이라 바뀌는 판정이 없다"
type RetroExemptionPreview {
    weekStart: String!
    retroactive: Boolean!
    items: [RetroExemptionImpact!]!
}

type RetroExemptionImpact {
    member: AdminMemberBrief!
    "면제로 바뀌기 전 판정 (통과 또는 미달)"
    currentStatus: AdminJudgmentStatus!
    impact: AdminRecalcImpact!
}
