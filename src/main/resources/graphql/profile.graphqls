# 프로필 조회 (기능명세서 8장, 화면설계서 PR-01).
# 사진 변경(S3 업로드)은 보류 중이라 없고, 팀별 경고(PR-01 ⑨)는 profile-warning.graphqls, 주간 판정 이력(⑩)은 profile-history.graphqls에서 확장한다

extend type Query {
    "프로필 (승인된 회원 누구나, 본인 · 타인 같은 모양). 없는 회원이나 승인되지 않은 회원은 NOT_FOUND"
    profile(memberId: ID!): Profile!
}

type Profile {
    id: ID!
    "GitHub 계정 이름. 수정할 수 없다"
    nickname: String!
    githubLogin: String!
    "S3 주소. null이면 기본 이미지"
    profileImageUrl: String
    "내 프로필인가 (프로필 수정 · 관리자 메뉴 버튼 노출 판단)"
    isMine: Boolean!
    "삭제되지 않은 글 수 (MongoDB 집계)"
    postCount: Int!
    "삭제되지 않은 댓글 수 (MongoDB 집계)"
    commentCount: Int!
    "GitHub 잔디. 캐시가 없으면 null (E-32). 하루 한 번 갱신한 캐시이고 이 쿼리가 GitHub를 부르지 않는다"
    grass: ProfileGrass
    "경고 합계 카드 (n / 3)"
    warning: ProfileWarning!
    "소속 팀. 공개 팀만 나오고 비공개 팀은 빠진다"
    teams: [ProfileTeam!]!
}

type ProfileGrass {
    "캐시가 덮는 첫 날 (yyyy-MM-dd)"
    from: String!
    "캐시가 덮는 마지막 날 (yyyy-MM-dd)"
    to: String!
    "갱신 기준 시각 (KST, ISO-8601). '오늘 오전 6시 기준'에 쓴다"
    fetchedAt: String!
    "날짜 오름차순, 날짜마다 기여 수 (0이면 잔디 없음)"
    days: [ProfileGrassDay!]!
}

type ProfileGrassDay {
    date: String!
    count: Int!
}

"저장된 카운트가 아니라 판정 이력을 처음부터 다시 훑어 계산한 값. 보류 주가 남아 있으면 onHold만 true이고 나머지는 null"
type ProfileWarning {
    onHold: Boolean!
    "벌칙 이행 이후 살아 있고 차감되지 않은 경고 수. 3을 넘을 수 있다"
    warningCount: Int
    "경고 3개 이상이면 벌칙 대상 (E-40)"
    penaltyTarget: Boolean
}

type ProfileTeam {
    id: ID!
    name: String!
}
