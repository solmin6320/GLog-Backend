# 팀 현황판 (기능명세서 2장 팀 현황판, 화면설계서 TM-05)와 내 팀 목록의 이번 주 요약 (TM-01 ⑧).
# 이번 주(월~일, KST) 값만 다룬다. 잔디는 하루 한 번 새벽에 갱신한 캐시를 그대로 보여주고 GitHub를 부르지 않는다

extend type Query {
    """
    팀 현황판 (TM-05). 그 팀의 현재 팀원·팀장만 볼 수 있다 (비소속·관리자 FORBIDDEN, 없거나 삭제된 팀 NOT_FOUND).
    인증일·잔디는 새벽 갱신 시점 값(grassFetchedAt이 기준 시각)이고, 기록글 수·경고 수는 조회할 때 읽는다.
    잔디를 못 불러온 팀원은 인증일이 null이고 나머지 값은 그대로 내려온다
    """
    teamBoard(teamId: ID!): TeamBoard!
}

extend type Team {
    "이번 주 요약 (TM-01 ⑧). 내 팀 목록에서 팀마다 불러도 쿼리가 팀 수만큼 늘지 않는다"
    weekSummary: TeamWeekSummary!
}

"팀 현황판 상태 칸. 미달은 주가 끝나고 판정이 확정된 뒤에만 나온다"
enum TeamBoardStatus {
    "인증일 3일 이상 그리고 기록글 1개 이상을 이미 채움"
    PASS
    "아직 못 채웠지만 주가 진행 중이라 만회할 수 있음"
    NOT_YET
    "판정이 미달로 확정됨"
    FAIL
    "판정 제외·면제 주 (첫 참가 주·면제 주간)"
    EXCLUDED
}

type TeamBoard {
    "이번 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    "이번 주 일요일 (yyyy-MM-dd)"
    weekEnd: String!
    "잔디 갱신 기준 시각 (KST, ISO-8601). 잔디 캐시가 있는 팀원 중 가장 오래된 시각이고, 하나도 없으면 null"
    grassFetchedAt: String
    "잔디를 못 불러온 팀원이 있는가 (E-32 배너)"
    grassNotLoaded: Boolean!
    "팀장이 맨 앞, 나머지는 참가한 순서"
    members: [TeamBoardMember!]!
    "이 팀에 연결된 기록글 최신 5건"
    recentPosts: [TeamBoardPost!]!
}

type TeamBoardMember {
    memberId: ID!
    nickname: String!
    githubLogin: String!
    "내 행인가"
    isMe: Boolean!
    "월~일 7행"
    days: [TeamBoardDay!]!
    "인증일 수 (잔디 또는 기록글이 있는 날, 같은 날 둘 다여도 1일). 잔디를 못 불러와 알 수 없으면 null"
    verifiedDays: Int
    "이번 주 기록글 수. 팀 연결과 무관한 개인 기준"
    recordCount: Int!
    "이 팀 카테고리가 붙은 지금 경고 수. 차감된 경고·벌칙 이행 이전 경고는 세지 않고, 다른 팀 경고와 벌칙 대상 여부는 담지 않는다. 판정 보류가 남아 알 수 없으면 null"
    warningCount: Int
    status: TeamBoardStatus!
}

"날짜별 한 칸. null은 알 수 없음(잔디를 못 불러왔거나 캐시 구간 밖)"
type TeamBoardDay {
    date: String!
    hasGrass: Boolean
    hasRecord: Boolean!
    "인증일인가 (잔디 또는 기록글). 둘 다 없는데 잔디를 모르면 null"
    verified: Boolean
}

"이 팀의 기록글 한 줄 (말머리·제목·작성자·날짜)"
type TeamBoardPost {
    id: ID!
    type: PostType!
    title: String!
    author: BoardAuthor!
    "작성 시각 (KST, ISO-8601)"
    createdAt: String!
}

"이번 주 요약. 판정 제외·면제인 팀원은 어느 쪽에도 세지 않는다"
type TeamWeekSummary {
    "이번 주 월요일 (yyyy-MM-dd)"
    weekStart: String!
    passCount: Int!
    "판정이 미달로 확정된 인원. 주가 끝나기 전에는 0"
    failCount: Int!
    "아직 못 채웠지만 주가 진행 중인 인원"
    notYetCount: Int!
}
