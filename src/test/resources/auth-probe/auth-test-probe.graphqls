# 테스트 전용 루트 필드. 상태·역할별 접근과 비로그인 차단을 시험하려고 둔다 (운영 스키마 아님)

extend type Query {
    "@PreAuthorize가 없는 필드. 접근 제어는 RootFieldAccessGuard가 맡는다"
    probeOpen: String!
    "ACTIVE 회원 이상만 (hasRole MEMBER)"
    probeMember: String!
    "예상 못 한 예외를 던지는 필드"
    probeFail: String!
    "깊이 한도 시험용. 자기 자신을 되풀이하는 타입"
    probeTree: ProbeNode
}

extend type Mutation {
    "ACTIVE 회원 이상만 (hasRole MEMBER)"
    probeMemberWrite: String!
    "Query.me와 이름만 같은 필드. 허용 목록이 루트 타입까지 보는지 시험한다"
    me: String!
}

type ProbeNode {
    id: ID!
    child: ProbeNode
}
