# 로컬 개발용 접속 정보. 복사해서 .env로 쓴다: cp .env.example .env
# .env는 커밋하지 않는다. docker-compose.yml과 application.yml이 같은 이름을 읽는다.
# 값을 바꾸지 않으면 아래 기본값이 그대로 적용된다.
# 운영(SPRING_PROFILES_ACTIVE=prod)은 기본값이 없다. DB_*·MONGODB_URI·REDIS_*(REDIS_SSL 포함)·
# BACKEND_BASE_URL·WEB_BASE_URL·GITHUB_*·JWT_SECRET을 모두 환경변수로 줘야 하고, 빠지면 기동이 실패한다.
# 두 URL은 https만 허용하고, 세션 쿠키 Secure는 true로 고정된다. ADMIN_GITHUB_IDS는 운영에서도 선택값이다.

# MariaDB
DB_HOST=localhost
# 로컬에 MariaDB·MySQL이 이미 3306을 쓰면 다른 포트(예: 3307)로 바꾼다
DB_PORT=3306
DB_NAME=jandilog
DB_USERNAME=jandilog
DB_PASSWORD=jandilog
# 선택(밀리초). 안 쓰면 기본값: DB_POOL_WAIT_TIMEOUT_MS=10000, DB_CONNECT_TIMEOUT_MS=10000, DB_SOCKET_TIMEOUT_MS=60000

# Redis (운영 Upstash: REDIS_HOST, REDIS_PASSWORD 지정, REDIS_SSL=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
# 선택. 안 쓰면 기본값: REDIS_COMMAND_TIMEOUT=5s, REDIS_CONNECT_TIMEOUT=5s

# MongoDB (운영 Atlas: mongodb+srv:// URI 전체)
# MONGO_PORT는 compose 호스트 포트. 바꾸면 MONGODB_URI의 포트도 맞춘다
MONGO_PORT=27017
MONGODB_URI=mongodb://localhost:27017/jandilog
# 선택. 안 쓰면 기본값: MONGO_CONNECT_TIMEOUT=5s, MONGO_SOCKET_TIMEOUT=30s, MONGO_SERVER_SELECTION_TIMEOUT=10s, MONGO_POOL_WAIT_TIMEOUT=10s (URI에 같은 옵션이 있으면 URI 값을 쓴다)

# GitHub OAuth App (Settings > Developer settings > OAuth Apps). 기본값 없음, 비우면 기동 실패
# 값은 실제 앱 것으로 채운다
# 콜백 URL은 BACKEND_BASE_URL + /login/oauth2/code/github 로 등록한다
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 백엔드 공개 주소(GitHub 콜백 기준). 로컬에서 SERVER_PORT를 바꾸면 같이 맞춘다
BACKEND_BASE_URL=http://localhost:8080
# 로그인 후 돌아갈 웹 주소. CORS 허용 출처도 이 값 하나만 쓴다
WEB_BASE_URL=http://localhost:5173
# 앱 딥링크 (제안 상태). 같은 스킴을 선언한 다른 앱이 코드를 가로채지 못하게 고유 스킴(역도메인형)을 쓴다
# 앱 쪽 스킴 등록과 같은 값이어야 한다. 바꿀 때는 이 값만 바꾼다
APP_DEEP_LINK=com.jandilog.app://auth
# OAuth 진행 중 세션 쿠키의 Secure 속성. 기본 true(운영 필수)
# 로컬 http에서 쿠키가 안 붙는 브라우저(예: Safari)를 쓰면 아래 값을 false로 바꾼다
# Chrome·Firefox는 http://localhost에서도 Secure 쿠키를 허용하므로 true 그대로 쓴다
SESSION_COOKIE_SECURE=true

# 첫 관리자로 지정할 GitHub 숫자 id(쉼표 구분). 기본값 비어 있음 = 아무도 승격되지 않는다 (운영에서도 선택값)
# 로그인할 때 목록에 있으면 새 회원은 처음부터 활성 관리자, 기존 회원(승인 대기·거절 포함)은 활성 관리자로 올린다
# 목록에서 빼도 이미 관리자인 계정은 강등하지 않는다 (강등은 DB에서 직접)
# GitHub 숫자 id 확인: 브라우저로 https://api.github.com/users/<GitHub 아이디> 를 열어 "id" 값을 본다
# 숫자만 받는다. 숫자가 아닌 항목·음수·빈 항목이 있으면 기동이 실패한다. 예: ADMIN_GITHUB_IDS=12345678,87654321
ADMIN_GITHUB_IDS=

# 잔디 조회용 GitHub 서버 토큰(Settings > Developer settings > Personal access tokens). 기본값 없음, 비우면 기동 실패
# 공개 정보만 읽으므로 권한(scope)은 하나도 주지 않아도 된다. 토큰은 로그·커밋에 남기지 않는다
GITHUB_API_TOKEN=

# JWT 서명 키: 43자 이상 무작위 문자열, 기본값 없음. 비우면 기동 실패
# 운영 키는 openssl rand -base64 48 로 만든다 (64자). 서로 다른 문자 16종 이상이어야 하고,
# 같은 문자·문자열 반복이나 changeme·password 같은 알려진 예시 값은 기동 때 거부한다
JWT_SECRET=
# 액세스 토큰 유효 시간(분). 기본 720(12시간), 1~43200. Refresh Token은 없고 만료되면 재로그인
JWT_EXPIRES_MINUTES=720
